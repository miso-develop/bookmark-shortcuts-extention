{
  "manifest_version": 3,
  "name": "Bookmark Shortcuts Minimal",
  "version": "1.1.0",
  "description": "Open bookmarks toolbar items and folders with Alt+1 through Alt+0.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bookmark-shortcuts-extention@miso-develop.github",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "bookmarks"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Bookmark Shortcuts",
    "default_area": "personaltoolbar",
    "default_icon": "icons/bookmark-shortcuts.svg",
    "default_popup": "folder.html"
  },
  "commands": {
    "open-bookmark-1": {
      "suggested_key": { "default": "Alt+1" },
      "description": "Open bookmark toolbar item 1"
    },
    "open-bookmark-2": {
      "suggested_key": { "default": "Alt+2" },
      "description": "Open bookmark toolbar item 2"
    },
    "open-bookmark-3": {
      "suggested_key": { "default": "Alt+3" },
      "description": "Open bookmark toolbar item 3"
    },
    "open-bookmark-4": {
      "suggested_key": { "default": "Alt+4" },
      "description": "Open bookmark toolbar item 4"
    },
    "open-bookmark-5": {
      "suggested_key": { "default": "Alt+5" },
      "description": "Open bookmark toolbar item 5"
    },
    "open-bookmark-6": {
      "suggested_key": { "default": "Alt+6" },
      "description": "Open bookmark toolbar item 6"
    },
    "open-bookmark-7": {
      "suggested_key": { "default": "Alt+7" },
      "description": "Open bookmark toolbar item 7"
    },
    "open-bookmark-8": {
      "suggested_key": { "default": "Alt+8" },
      "description": "Open bookmark toolbar item 8"
    },
    "open-bookmark-9": {
      "suggested_key": { "default": "Alt+9" },
      "description": "Open bookmark toolbar item 9"
    },
    "open-bookmark-10": {
      "suggested_key": { "default": "Alt+0" },
      "description": "Open bookmark toolbar item 10"
    },
    "open-bookmark-new-1": {
      "suggested_key": { "default": "Alt+Shift+1" },
      "description": "Open bookmark toolbar item 1 in a new tab"
    },
    "open-bookmark-new-2": {
      "suggested_key": { "default": "Alt+Shift+2" },
      "description": "Open bookmark toolbar item 2 in a new tab"
    },
    "open-bookmark-new-3": {
      "suggested_key": { "default": "Alt+Shift+3" },
      "description": "Open bookmark toolbar item 3 in a new tab"
    },
    "open-bookmark-new-4": {
      "suggested_key": { "default": "Alt+Shift+4" },
      "description": "Open bookmark toolbar item 4 in a new tab"
    },
    "open-bookmark-new-5": {
      "suggested_key": { "default": "Alt+Shift+5" },
      "description": "Open bookmark toolbar item 5 in a new tab"
    },
    "open-bookmark-new-6": {
      "suggested_key": { "default": "Alt+Shift+6" },
      "description": "Open bookmark toolbar item 6 in a new tab"
    },
    "open-bookmark-new-7": {
      "suggested_key": { "default": "Alt+Shift+7" },
      "description": "Open bookmark toolbar item 7 in a new tab"
    },
    "open-bookmark-new-8": {
      "suggested_key": { "default": "Alt+Shift+8" },
      "description": "Open bookmark toolbar item 8 in a new tab"
    },
    "open-bookmark-new-9": {
      "suggested_key": { "default": "Alt+Shift+9" },
      "description": "Open bookmark toolbar item 9 in a new tab"
    },
    "open-bookmark-new-10": {
      "suggested_key": { "default": "Alt+Shift+0" },
      "description": "Open bookmark toolbar item 10 in a new tab"
    }
  }
}
